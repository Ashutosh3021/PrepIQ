# =============================================================================
# PrepIQ Frontend — Environment Template
# =============================================================================
# cp frontend/.env.example frontend/.env.local
# NEVER commit .env.local
# =============================================================================

# mock | real
NEXT_PUBLIC_API_MODE=real

# Backend origin OR full /api/v1 URL (both supported; do not double-append)
# Examples:
#   http://localhost:8000
#   http://localhost:8000/api/v1
#   https://prepiq-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Feature flags
NEXT_PUBLIC_ENABLE_AI_TUTOR=true
NEXT_PUBLIC_ENABLE_PREDICTIONS=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# OAuth / Supabase no longer required for auth
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
