# =============================================================================
# PrepIQ Backend — Environment Template (Pyronites-first)
# =============================================================================
# cp backend/.env.example backend/.env
# NEVER commit backend/.env
# =============================================================================

# -----------------------------------------------------------------------------
# PYRONITES  (required for auth + data)
# -----------------------------------------------------------------------------
PYRONITES_URL=https://your-pyronites-backend.example
PYRONITES_KEY=pyro_live_...

# Local paper files (no cloud storage basket)
UPLOAD_ROOT=./uploads

# -----------------------------------------------------------------------------
# SECURITY  (required)
# -----------------------------------------------------------------------------
JWT_SECRET=replace-with-a-random-32-char-minimum-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=https://your-app.vercel.app

# -----------------------------------------------------------------------------
# AI / LLM provider layer
# -----------------------------------------------------------------------------
LLM_DEFAULT_PROVIDER=gemini
LLM_DEFAULT_MODEL=gemini-1.5-flash
LLM_DEFAULT_API_KEY=
LLM_DEFAULT_BASE_URL=

PREDICTION_PROVIDER=
PREDICTION_MODEL=
PREDICTION_API_KEY=
PREDICTION_BASE_URL=

EXTRACTION_PROVIDER=
EXTRACTION_MODEL=
EXTRACTION_API_KEY=
EXTRACTION_BASE_URL=

CHAT_PROVIDER=
CHAT_MODEL=
CHAT_API_KEY=
CHAT_BASE_URL=

# Legacy Gemini key still accepted as fallback API key
GEMINI_API_KEY=

# Prediction knobs (optional)
PREDICTION_MIN_PAPERS_FULL=3
PREDICTION_MAX_ITEMS=10
PREDICTION_CONTEXT_CHARS=12000

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
HEALTH_ENDPOINT=https://your-service.onrender.com/health

MAX_FILE_SIZE=20971520
ENABLE_HEAVY_ML=false

# -----------------------------------------------------------------------------
# OBSOLETE (kept only so old .env files do not crash settings)
# Not required for auth / subjects / papers / predictions / tests
# -----------------------------------------------------------------------------
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# SUPABASE_ANON_KEY=
