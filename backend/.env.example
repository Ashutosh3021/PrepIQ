# =============================================================================
# PrepIQ Backend — Environment Template
# =============================================================================
# Copy to backend/.env and fill in real values.
#
#   cp backend/.env.example backend/.env
#
# NEVER commit backend/.env — it is already in .gitignore.
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE  (required)
# -----------------------------------------------------------------------------
# Supabase Transaction Pooler — port 6543.
# The app strips ?pgbouncer=true automatically.
#
# Find it: Supabase Dashboard → Project Settings → Database
#          → Connection string → Transaction pooler
#
DATABASE_URL=postgresql://postgres.YOURPROJECT:YOURPASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true


# -----------------------------------------------------------------------------
# SUPABASE  (required)
# -----------------------------------------------------------------------------
# Find both keys: Supabase Dashboard → Project Settings → API

# Project URL
SUPABASE_URL=https://YOURPROJECT.supabase.co

# Service Role key — server-side only, NEVER expose to the browser
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key...

# Anon key — kept here for reference; the frontend reads its own copy
SUPABASE_ANON_KEY=eyJ...your-anon-key...


# -----------------------------------------------------------------------------
# SECURITY  (required)
# -----------------------------------------------------------------------------
# Generate a strong secret: openssl rand -base64 32
# In production the app will refuse to start if this is missing or set to the
# default placeholder value.
JWT_SECRET=replace-with-a-random-32-char-minimum-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# -----------------------------------------------------------------------------
# CORS  (required)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# In development mode (ENVIRONMENT=development) the backend allows all origins
# automatically, so this only matters in staging / production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Your deployed frontend URL — used to restrict CORS in production
FRONTEND_URL=https://your-app.vercel.app


# -----------------------------------------------------------------------------
# AI / LLM provider layer (Phase 1)
# -----------------------------------------------------------------------------
# Resolution per capability (prediction | extraction | chat):
#   1. CAPABILITY_* if set
#   2. else LLM_DEFAULT_*
#   3. else legacy GEMINI_API_KEY as the API key (provider/model still default)
#   4. else feature is unavailable → existing graceful fallbacks
#
# Model names live ONLY in env / the provider module — not in call sites.

# Shared defaults
LLM_DEFAULT_PROVIDER=gemini
LLM_DEFAULT_MODEL=gemini-1.5-flash
LLM_DEFAULT_API_KEY=
LLM_DEFAULT_BASE_URL=

# Prediction (exam topic / question prediction)
PREDICTION_PROVIDER=
PREDICTION_MODEL=
PREDICTION_API_KEY=
PREDICTION_BASE_URL=

# Extraction (paper/text → questions or structured extract)
EXTRACTION_PROVIDER=
EXTRACTION_MODEL=
EXTRACTION_API_KEY=
EXTRACTION_BASE_URL=

# Chat / AI tutor
CHAT_PROVIDER=
CHAT_MODEL=
CHAT_API_KEY=
CHAT_BASE_URL=

# Legacy Google Gemini key — still accepted as fallback API key by the provider
# layer when capability-specific / LLM_DEFAULT_API_KEY are empty.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...your-gemini-key...

# Bytez — optional; not the default provider path after Phase 1
# https://bytez.com
BYTEZ_API_KEY=your-bytez-api-key


# -----------------------------------------------------------------------------
# APPLICATION  (optional — defaults shown)
# -----------------------------------------------------------------------------
# development | staging | production
# In production the app performs hard validation of all required vars.
ENVIRONMENT=development

# Set true to expose /docs, /redoc, /openapi.json
DEBUG=true

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Server bind — used when running `python app/main.py` directly
HOST=0.0.0.0
PORT=8000


# Keep-alive ping URL — the backend pings this every 14 min to prevent
# Render free-tier spin-down. Set to your deployed Render service URL.
# Only active when ENVIRONMENT=production.
HEALTH_ENDPOINT=https://your-service.onrender.com/health

# -----------------------------------------------------------------------------
# FILE UPLOADS  (optional — defaults shown)
# -----------------------------------------------------------------------------
# Temporary directory for files before they are uploaded to Supabase Storage
UPLOAD_FOLDER=./uploads

# Maximum upload size in bytes (default 10 MB)
MAX_FILE_SIZE=10485760

# Enable heavy ML pipeline: EasyOCR, YOLOv8, Transformers.
# Requires ~4 GB RAM. Leave false on Render free tier.
ENABLE_HEAVY_ML=false


# -----------------------------------------------------------------------------
# REDIS  (optional)
# -----------------------------------------------------------------------------
# Uncomment if you add Redis-backed caching or rate limiting.
# REDIS_URL=redis://localhost:6379


# -----------------------------------------------------------------------------
# EMAIL / SMTP  (optional)
# -----------------------------------------------------------------------------
# Uncomment to enable email notifications.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
